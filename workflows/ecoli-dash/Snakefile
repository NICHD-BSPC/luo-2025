configfn = 'config/config.yaml'
config = yaml.safe_load(open(configfn))

gtf_colnames = ['chrom', 'source', 'feature', 'start', 'end',
                'score', 'strand', 'na', 'name']

bed_colnames = ['chrom', 'start', 'end', 'name', 'score', 'strand']

wildcard_constraints:
    # This prevents wildcards to be interpreted as regexes
    ext = '|'.join(['fna', 'gtf'])

